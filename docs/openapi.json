 "components": {
  "schemas": {
   "AvailabilityIn": {
    "properties": {
     "production_id": {
      "type": "string",
      "format": "uuid",
      "title": "Production Id"
     },
     "cast": {
      "type": "string",
      "maxLength": 80,
      "minLength": 1,
      "title": "Cast"
     },
     "unavailable": {
      "items": {
       "type": "string",
       "format": "date"
      },
      "type": "array",
      "maxItems": 200,
      "title": "Unavailable"
     }
    },
    "type": "object",
    "required": [
     "production_id",
     "cast",
     "unavailable"
    ],
    "title": "AvailabilityIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "OptimizeIn": {
    "properties": {
     "scenario_id": {
      "type": "string",
      "format": "uuid",
      "title": "Scenario Id"
     },
     "seconds": {
      "type": "number",
      "maximum": 60.0,
      "minimum": 1.0,
      "title": "Seconds",
      "description": "Time the solver may spend; it returns the best schedule found",
      "default": 12
     }
    },
    "type": "object",
    "required": [
     "scenario_id"
    ],
    "title": "OptimizeIn"
   },
   "ParseIn": {
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1,
      "title": "Title"
     },
     "source": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^demo-screenplay$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source",
      "description": "Use the built-in synthetic screenplay instead of sending text"
     },
     "text": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 600000
       },
       {
        "type": "null"
       }
      ],
      "title": "Text",
      "description": "A screenplay in standard format"
     },
     "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
     },
     "shoot_days": {
      "type": "integer",
      "maximum": 80.0,
      "minimum": 1.0,
      "title": "Shoot Days",
      "description": "Weekdays available for shooting, from the start date",
      "default": 24
     },
     "budget": {
      "type": "number",
      "maximum": 1000000000.0,
      "minimum": 0.0,
      "title": "Budget"
     }
    },
    "type": "object",
    "required": [
     "title",
     "start_date",
     "budget"
    ],
    "title": "ParseIn"
   },
   "ScenarioIn": {
    "properties": {
     "production_id": {
      "type": "string",
      "format": "uuid",
      "title": "Production Id"
     },
     "name": {
      "type": "string",
      "maxLength": 80,
      "minLength": 1,
      "title": "Name"
     },
     "based_on": {
      "anyOf": [
       {
        "type": "string",
        "format": "uuid"
       },
       {
        "type": "null"
       }
      ],
      "title": "Based On",
      "description": "An earlier scenario whose schedule this one should stay close to"
     },
     "unavailable": {
      "additionalProperties": {
       "items": {
        "type": "string",
        "format": "date"
       },
       "type": "array"
      },
      "type": "object",
      "title": "Unavailable",
      "description": "Extra unavailable dates per cast member, on top of POST /v1/availability"
     },
     "rain": {
      "additionalProperties": {
       "type": "number"
      },
      "propertyNames": {
       "format": "date"
      },
      "type": "object",
      "title": "Rain",
      "description": "Chance of rain by date, 0 to 1"
     }
    },
    "type": "object",
    "required": [
     "production_id",
     "name"
    ],
    "title": "ScenarioIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}